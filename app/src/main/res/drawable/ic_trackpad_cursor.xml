        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.1"
        android:pathData="M4,2 L4,18 L8,14.2 L10.5,20 L13,19 L10.5,13.2 L16,13.2 Z" />
</vector>
